{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YGO Trainer",
  "version": "../package.json",
  "identifier": "ch.rmencattini.ygotrainer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../apps/ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "YGO Trainer",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
